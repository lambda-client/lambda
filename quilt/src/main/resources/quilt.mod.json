{
  "schema_version": 1,
  "mixin": [
    "lambda.mixins.common.json"
  ],
  "quilt_loader": {
    "group": "${group}",
    "id": "${mod_id}",
    "version": "${mod_version}",
    "metadata": {
      "name": "Lambda",
      "description": "${mod_description}",
      "contributors": {
        "Constructor": "Owner"
      },
      "contact": {
        "sources": "https://github.com/lambda-client/lambda"
      },
      "icon": "assets/lambda/lambda.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
    "entrypoints": {
      "init": [
        "com.lambda.quilt.LambdaQuilt"
      ]
    },
    "depends": [
      {
        "id": "quilt_loader",
        "version": "*"
      },
      {
        "id": "quilt_base",
        "version": "*"
      },
      {
        "id": "qkl",
        "version": ">=3.0.0"
      },
      {
        "id": "minecraft",
        "version": ">=1.20.1"
      },
      {
        "id": "architectury",
        "version": ">=9.1.12"
      }
    ]
  },
  "minecraft": {
    "environment": "*"
  }
}
